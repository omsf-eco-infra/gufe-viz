          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/SmallMoleculeData"
        }
      },
      "required": [
        "data",
        "kind"
      ],
      "title": "SmallMoleculePayload",
      "type": "object"
    },
    "SolventData": {
      "additionalProperties": false,
      "properties": {
        "smiles": {
          "default": "O",
          "type": "string"
        },
        "positive_ion": {
