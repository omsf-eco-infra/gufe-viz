          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The object's name, for the title bar."
        },
        "extra": {
          "additionalProperties": true,
          "description": "Reserved forward-compatibility slot. The only place additional properties are permitted; V1 views ignore its contents entirely.",
          "type": "object"
        },
        "kind": {
          "const": "ProteinComponent",
          "default": "ProteinComponent",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ProteinData"
        }
      },
      "required": [
        "data",
        "kind"
      ],
      "title": "ProteinPayload",
      "type": "object"
    },
    "SmallMoleculeData": {
      "additionalProperties": false,
      "properties": {
        "sdf": {
          "description": "SmallMoleculeComponent.to_sdf() output, verbatim.",
          "type": "string"
        },
        "smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
