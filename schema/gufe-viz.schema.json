  "discriminator": {
    "mapping": {
      "AlchemicalNetwork": "#/$defs/AlchemicalNetworkPayload",
      "ChemicalSystem": "#/$defs/ChemicalSystemPayload",
      "LigandAtomMapping": "#/$defs/LigandAtomMappingPayload",
      "LigandNetwork": "#/$defs/LigandNetworkPayload",
      "ProteinComponent": "#/$defs/ProteinPayload",
      "SmallMoleculeComponent": "#/$defs/SmallMoleculePayload",
      "SolventComponent": "#/$defs/SolventPayload",
      "Transformation": "#/$defs/TransformationPayload"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SmallMoleculePayload"
    },
    {
      "$ref": "#/$defs/ProteinPayload"
    },
    {
      "$ref": "#/$defs/SolventPayload"
    },
    {
      "$ref": "#/$defs/LigandAtomMappingPayload"
    },
    {
      "$ref": "#/$defs/LigandNetworkPayload"
    },
    {
